# Токен Discord-бота (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# Айди гильдии (сервера), в рамках которой работает бот
GUILD_ID=

# Айди чата, где доступна команда /tournament_active
SETUP_CHANNEL_ID=

# Айди чата, где доступна команда /tournament_join
REGISTRATION_CHANNEL_ID=

# Айди чата, куда публикуется embed с данными заявки после подтверждения формы
NOTIFICATION_CHANNEL_ID=

# Айди ролей, которым разрешено создавать/редактировать турнир (через запятую)
MANAGER_ROLE_IDS=

# Айди роли, которой разрешено принять участие в турнире
PARTICIPANT_ROLE_ID=

# true/false — публиковать ли embed с заявкой в NOTIFICATION_CHANNEL_ID
POST_TO_CHANNEL_ENABLED=true

# Путь к файлу SQLite-БД (опционально, по умолчанию tournaments.db в рабочей директории)
DB_PATH=tournaments.db
