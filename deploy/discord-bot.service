[Unit]
Description=py-discord-tournaments Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordbot
WorkingDirectory=/var/www/py-discord-tournaments
EnvironmentFile=/var/www/py-discord-tournaments/.env
ExecStart=/var/www/py-discord-tournaments/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=60
# Провал стартовых проверок (код 3) — не перезапускать: нужна правка конфигурации на сервере.
RestartPreventExitStatus=3
# Не более 5 перезапусков за 10 минут, затем systemd прекращает попытки.
StartLimitIntervalSec=600
StartLimitBurst=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
